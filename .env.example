# ---- Go API (copy to apps/api/.env; never commit real keys) ----
DATABASE_URL=postgres://fluentpath:fluentpath@localhost:5433/fluentpath?sslmode=disable
COURSES_DIR=../../packages/courses
# Day boundary for streaks
APP_TIMEZONE=Asia/Jakarta
PORT=8080
# Comma-separated origins allowed to call the API from a browser (Expo Web dev server is :8081)
CORS_ORIGINS=http://localhost:8081

# Per-IP requests/minute (defaults: 240 overall, 30 tutor/assessment, 10 login/register)
# RATE_LIMIT_PER_MIN=240
# AI_RATE_LIMIT_PER_MIN=30
# AUTH_RATE_LIMIT_PER_MIN=10

# Serve the exported web app from the API so phones on the LAN can open
# http://<your-LAN-IP>:8080 (build it first: cd apps/mobile && npx expo export -p web)
# WEB_DIR=../mobile/dist

# mock = deterministic offline tutor (no key needed); openai = real tutor
AI_PROVIDER=mock
OPENAI_API_KEY=
# Check https://developers.openai.com/api/docs/models for current model IDs
OPENAI_MODEL=gpt-6-luna
OPENAI_EVAL_MODEL=gpt-6.1-sol

# ---- Expo app (copy to apps/mobile/.env) ----
# Public, non-secret. Android emulator: http://10.0.2.2:8080 ; physical device: http://<your-LAN-IP>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
